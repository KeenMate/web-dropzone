<!-- Async loading demo script -->
<script>
// Wait for DOM and MultiSelect to be available
document.addEventListener('DOMContentLoaded', () => {
  // Fake product database
  const allProducts = [
    { value: 'laptop-1', label: 'MacBook Pro 16"', subtitle: 'Apple M3 Max, 32GB RAM', icon: '💻' },
    { value: 'laptop-2', label: 'Dell XPS 15', subtitle: 'Intel i9, 32GB RAM', icon: '💻' },
    { value: 'laptop-3', label: 'ThinkPad X1 Carbon', subtitle: 'Intel i7, 16GB RAM', icon: '💻' },
    { value: 'phone-1', label: 'iPhone 15 Pro', subtitle: '256GB, Titanium', icon: '📱' },
    { value: 'phone-2', label: 'Samsung Galaxy S24', subtitle: '512GB, Phantom Black', icon: '📱' },
    { value: 'phone-3', label: 'Google Pixel 8 Pro', subtitle: '256GB, Obsidian', icon: '📱' },
    { value: 'tablet-1', label: 'iPad Pro 12.9"', subtitle: 'M2, 256GB', icon: '📱' },
    { value: 'tablet-2', label: 'Surface Pro 9', subtitle: 'Intel i7, 16GB', icon: '📱' },
    { value: 'monitor-1', label: 'LG UltraWide 34"', subtitle: '3440x1440, 144Hz', icon: '🖥️' },
    { value: 'monitor-2', label: 'Dell UltraSharp 27"', subtitle: '4K, IPS', icon: '🖥️' },
    { value: 'keyboard-1', label: 'Keychron K8 Pro', subtitle: 'Mechanical, Wireless', icon: '⌨️' },
    { value: 'mouse-1', label: 'Logitech MX Master 3S', subtitle: 'Wireless, Ergonomic', icon: '🖱️' }
  ];

  // Simulate async API call with random delay
  async function searchProducts(searchTerm) {
    // Random delay between 300-1200ms
    const delay = 300 + Math.random() * 900;
    await new Promise(resolve => setTimeout(resolve, delay));

    // Filter products by search term
    return allProducts.filter(product => {
      const searchLower = searchTerm.toLowerCase();
      return product.label.toLowerCase().includes(searchLower) ||
             product.subtitle.toLowerCase().includes(searchLower);
    });
  }

  // Initialize async multiselect
  const asyncElement = document.getElementById('async-multiselect');
  if (asyncElement) {
    new MultiSelect(asyncElement, {
      onSearch: searchProducts,
      minSearchLength: 2
    });
  }

  // Initialize async multiselect with count display
  const asyncCountElement = document.getElementById('async-count-multiselect');
  if (asyncCountElement) {
    new MultiSelect(asyncCountElement, {
      onSearch: searchProducts,
      minSearchLength: 2
    });
  }
});
</script>
