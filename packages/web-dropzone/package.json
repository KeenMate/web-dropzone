{
  "name": "@keenmate/web-dropzone",
  "version": "1.0.0-rc01",
  "description": "Lightweight file dropzone web component with drag-drop, previews, validation, and multiple display modes.",
  "type": "module",
  "main": "./dist/dropzone.umd.js",
  "module": "./dist/dropzone.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dropzone.js",
      "require": "./dist/dropzone.umd.js",
      "default": "./dist/dropzone.js"
    },
    "./style.css": "./dist/style.css",
    "./css": "./src/css/main.css",
    "./manifest": "./component-variables.manifest.json",
    "./dist/*": "./dist/*",
    "./src/css/*": "./src/css/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/dropzone.js",
    "./dist/dropzone.umd.js",
    "*.css"
  ],
  "files": [
    "dist",
    "src/css",
    "component-variables.manifest.json"
  ],
  "scripts": {
    "build": "npm run clean && vite build && tsc -b",
    "build:types": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "keywords": [
    "dropzone",
    "file-upload",
    "drag-drop",
    "file-input",
    "file-selector",
    "upload",
    "web-component",
    "custom-element",
    "file-preview",
    "keenmate"
  ],
  "author": "Keenmate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenmate/web-dropzone.git",
    "directory": "packages/web-dropzone"
  },
  "homepage": "https://github.com/keenmate/web-dropzone#readme",
  "bugs": {
    "url": "https://github.com/keenmate/web-dropzone/issues"
  },
  "dependencies": {
    "@keenmate/web-components-core": "^1.0.0-rc03",
    "@keenmate/web-dropzone-core": "1.0.0-rc01"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "vitest": "^2.1.9"
  }
}
